# Server-side only. Never prefix with NEXT_PUBLIC_. Leave blank to use labelled sample data.

# One Piece via tcgapi.dev (free key, 100 requests/day): https://tcgapi.dev/dashboard
ONE_PIECE_API_KEY=
# The One Piece game slug as listed by tcgapi.dev's games endpoint (check https://tcgapi.dev/api). Both vars are needed.
ONE_PIECE_GAME=

# Sports / Topps via the official PriceCharting API token (paid subscription): https://www.pricecharting.com/api-documentation
SPORTS_CARD_API_KEY=
