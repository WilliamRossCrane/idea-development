# Server-side only. Never prefix with NEXT_PUBLIC_. Leave blank to use labelled sample data.

# Preferred One Piece API via BerryWallet (shared key for its Pokémon and One Piece APIs).
BERRYWALLET_API_KEY=

# English One Piece fallback via tcgapi.dev (free key): https://tcgapi.dev/dashboard
ONE_PIECE_API_KEY=
# Optional slug override (defaults to one-piece-card-game, verified from the public games endpoint).
ONE_PIECE_GAME=

# Sports / Topps via the official PriceCharting API token (paid subscription): https://www.pricecharting.com/api-documentation
SPORTS_CARD_API_KEY=
